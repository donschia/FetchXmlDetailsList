<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
  </PropertyGroup>
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props')" />
  <PropertyGroup>
    <ProjectGuid>df60aa31-9ff3-40c7-80af-5c65692c2ae3</ProjectGuid>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <!--Remove TargetFramework when this is available in 16.1-->
    <TargetFramework>net462</TargetFramework>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <SolutionRootPath>src</SolutionRootPath>
  </PropertyGroup>
  <!-- Solution Packager overrides, un-comment to use: SolutionPackagerType (Managed, Unmanaged, Both) -->
  <PropertyGroup>
    <SolutionPackageType>Both</SolutionPackageType>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="1.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\.gitignore" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\bin\**" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\obj\**" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.cdsproj" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.cdsproj.user" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.sln" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)\**" Exclude="@(ExcludeDirectories)" />
    <Content Include="$(SolutionPackageZipFilePath)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FetchXmlDetailsList.pcfproj" />
  </ItemGroup>
  
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets')" />
  
  <!-- Read version from Solution.xml -->
  <Target Name="GetSolutionVersion" BeforeTargets="Build">
    <XmlPeek XmlInputPath="$(SolutionRootPath)\Other\Solution.xml" Query="/ImportExportXml/SolutionManifest/Version/text()">
      <Output TaskParameter="Result" PropertyName="SolutionVersion" />
    </XmlPeek>
    <Message Text="Solution Version: $(SolutionVersion)" Importance="high" />
  </Target>
  
  <!-- Fallback Build target if Visual Studio targets don't exist -->
  <Target Name="Build" Condition="!Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets')" DependsOnTargets="GetSolutionVersion">
    <Message Text="Building solution package using PAC CLI..." Importance="high" />
    <MakeDir Directories="$(OutputPath)" />
    <Exec Command="pac solution pack --zipfile &quot;$(OutputPath)FetchXmlDetailsList_$(Configuration)_$(SolutionVersion)_Unmanaged.zip&quot; --folder &quot;$(SolutionRootPath)&quot; --packagetype Unmanaged" />
    <Exec Command="pac solution pack --zipfile &quot;$(OutputPath)FetchXmlDetailsList_$(Configuration)_$(SolutionVersion)_Managed.zip&quot; --folder &quot;$(SolutionRootPath)&quot; --packagetype Managed" />
  </Target>
  
  <Target Name="Restore" />
  <Target Name="Clean">
    <RemoveDir Directories="$(OutputPath)" />
    <RemoveDir Directories="obj" />
  </Target>
  
</Project>